# Database URL for PostgreSQL
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://moesio:moesio@localhost:5432/plates

# Flask server
FLASK_HOST=0.0.0.0
FLASK_PORT=9009

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Config cache TTL in seconds
CONFIG_CACHE_TTL=10

# RTSP monitoring
RTSP_DEBUG_DIR=
RTSP_DEBUG_SAVE_INTERVAL=30
RTSP_JPEG_QUALITY=70
RTSP_RECONNECT_DELAY=3.0
RTSP_RECONNECT_BACKOFF=1.5
RTSP_RECONNECT_DELAY_MAX=30.0
# Interval (s) between ALPR runs per RTSP camera (fallback: RTSP_FRAME_SLEEP)
RTSP_DETECT_INTERVAL=1.0
# Pause (s) between live frames published (0 = publish as fast as the camera sends)
RTSP_CAPTURE_FRAME_SLEEP=0.05
# Poll interval (s) for the MJPEG live stream
RTSP_POLL_INTERVAL=0.10
# Seconds without frames before the MJPEG stream ends
RTSP_STREAM_TIMEOUT=10.0

# Detections pagination
DETECTIONS_MAX_PER_PAGE=200

# Gunicorn (Docker). Keep GUNICORN_WORKERS=1: the RTSP/live state is in-process
# memory, so multiple workers would duplicate capture/detection and break dedup.
GUNICORN_WORKERS=1
GUNICORN_THREADS=16
